<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>message board</title>
</head>
<body>
    <h1>Message Board</h1>

    <% for(m of messages) { %>
    <p> <%= m.text %> - <%= m.user %> </p> 
    <p><%= m.added %></p>   
        

   <% } %>

   <a href="/message/new">make a new message</a>
</body>
</html>